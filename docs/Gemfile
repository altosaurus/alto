# The docs are built with the same Jekyll and plugins that GitHub Pages uses, so a build here looks like the published one.
# Run `bundle install` once in this folder, then see "Building the docs" in docs/development.md.
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick" # `jekyll serve` needs it on Ruby 3 and later
